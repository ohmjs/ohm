-- @../../packages/ohm-js/src/ohm-grammar.ohm --
relative to golang/cli directory

-- file.txt --
RuleAst {
  Grammar =     name #"\n" Rule*
  Rule =        name ruleDescr? rulecase "{" RuleDetails* "}"
  RuleDetails = name Nodetype #("\n"|";")
  Nodetype =
    | #("node" (" "|"\t")*)             -- node
    | #("rule" (" "|"\t")+)  name      -- rule
    | #("term" (" "|"\t")*)             -- term
    | #("list" (" "|"\t")+)  Nodetype   -- list
    | #("opt"  (" "|"\t")+)  Nodetype   -- opt
    | #("hor"  (" "|"\t")+)  hor_id "<" ListOf<Nodetype, ","> ">" -- hor

  rulecase =
    | "define" ~(alnum)
    | "override" ~(alnum)
    | "extend" ~(alnum)
  ruleDescr  = "(" ruleDescrText ")"
  ruleDescrText = (~")" any)*
  name = alnum+
  hor_id = alnum+
}
